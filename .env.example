# Copia este archivo a ".env" y rellena los valores.
# NUNCA subas el .env real a Git (ya está en .gitignore).

# --- Supabase (tu base de datos + auth) ---
# Las encuentras en tu proyecto de Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- IA ---
# "mock" = funciona sin gastar tokens (default, ideal para empezar)
# "real" = llama a tu proveedor de verdad
VITE_AI_MODE=mock

# Solo si VITE_AI_MODE=real. Usa el proveedor que prefieras (Gemini, Claude, OpenAI...).
# OJO: en producción, las llamadas a la IA van desde tu backend, no desde el navegador.
VITE_AI_API_KEY=

# --- Orwel (analítica, opcional) ---
VITE_ORWEL_KEY=
