# Copia este archivo a ".env" y rellena los valores.
# NUNCA subas el .env real a Git (ya está en .gitignore).

# --- Supabase (tu base de datos + auth) ---
# Las encuentras en tu proyecto de Supabase -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- IA (frontend React legacy, opcional) ---
# "mock" = funciona sin gastar tokens (default, ideal para empezar)
# "real" = llama a tu proveedor de verdad
VITE_AI_MODE=mock
VITE_AI_API_KEY=

# --- IA de Último Recurso (backend server.js → Claude) ---
# Llave de la API de Claude (Anthropic). Vive SOLO en el servidor, nunca en el navegador.
# Consíguela en https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Puerto del servidor (opcional, por defecto 8080)
# PORT=8080

# --- Orwel (analítica, opcional) ---
VITE_ORWEL_KEY=
